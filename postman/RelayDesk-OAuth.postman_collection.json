{
  "info": {
    "name": "RelayDesk OAuth troubleshooting",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local synthetic client credentials only. Run the whole collection in order; tokens expire after 20 seconds. Never save real secrets or tokens to a shared collection."
  },
  "variable": [
    {
      "key": "identity_url",
      "value": "http://127.0.0.1:8085"
    },
    {
      "key": "gateway_url",
      "value": "http://127.0.0.1:8083"
    },
    {
      "key": "client_id",
      "value": "acme-client"
    },
    {
      "key": "client_secret",
      "value": "acme-client-local-secret"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "wrong_audience_token",
      "value": ""
    },
    {
      "key": "unknown_tenant_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Obtain demo access token",
      "request": {
        "method": "POST",
        "url": "{{identity_url}}/realms/relaydesk/protocol/openid-connect/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            },
            {
              "key": "client_id",
              "value": "{{client_id}}"
            },
            {
              "key": "client_secret",
              "value": "{{client_secret}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"access_token\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Access token issued\", function () { pm.expect(pm.response.json().access_token).to.be.a(\"string\").and.not.empty; });",
              "if (pm.response.code === 200) { pm.collectionVariables.set(\"access_token\", pm.response.json().access_token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Call orders with demo token",
      "request": {
        "method": "GET",
        "url": "{{gateway_url}}/v1/orders",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Request ID returned\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok; });",
              "pm.test(\"Orders returned\", function () { pm.expect(pm.response.json().orders).to.be.an(\"array\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject missing token",
      "request": {
        "method": "GET",
        "url": "{{gateway_url}}/v1/orders",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
              "pm.test(\"Request ID returned\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok; });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject wrong client secret",
      "request": {
        "method": "POST",
        "url": "{{identity_url}}/realms/relaydesk/protocol/openid-connect/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            },
            {
              "key": "client_id",
              "value": "acme-client"
            },
            {
              "key": "client_secret",
              "value": "wrong-demo-secret"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Obtain wrong-audience demo token",
      "request": {
        "method": "POST",
        "url": "{{identity_url}}/realms/relaydesk/protocol/openid-connect/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            },
            {
              "key": "client_id",
              "value": "wrong-audience"
            },
            {
              "key": "client_secret",
              "value": "wrong-audience-local-secret"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"wrong_audience_token\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Access token issued\", function () { pm.expect(pm.response.json().access_token).to.be.a(\"string\").and.not.empty; });",
              "if (pm.response.code === 200) { pm.collectionVariables.set(\"wrong_audience_token\", pm.response.json().access_token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject wrong-audience token",
      "request": {
        "method": "GET",
        "url": "{{gateway_url}}/v1/orders",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{wrong_audience_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
              "pm.test(\"Request ID returned\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok; });"
            ]
          }
        }
      ]
    },
    {
      "name": "Obtain unmapped-tenant demo token",
      "request": {
        "method": "POST",
        "url": "{{identity_url}}/realms/relaydesk/protocol/openid-connect/token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            },
            {
              "key": "client_id",
              "value": "unknown-tenant"
            },
            {
              "key": "client_secret",
              "value": "unknown-tenant-local-secret"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"unknown_tenant_token\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Access token issued\", function () { pm.expect(pm.response.json().access_token).to.be.a(\"string\").and.not.empty; });",
              "if (pm.response.code === 200) { pm.collectionVariables.set(\"unknown_tenant_token\", pm.response.json().access_token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject unmapped tenant",
      "request": {
        "method": "GET",
        "url": "{{gateway_url}}/v1/orders",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{unknown_tenant_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });",
              "pm.test(\"Request ID returned\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok; });"
            ]
          }
        }
      ]
    }
  ]
}
