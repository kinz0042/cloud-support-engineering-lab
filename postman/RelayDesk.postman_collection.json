{
  "info": {
    "name": "RelayDesk support investigations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Synthetic local-only requests. Run the whole collection in order. Never put real credentials or customer data in a shared collection."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8081"
    },
    {
      "key": "acme_key",
      "value": "acme-local-key"
    },
    {
      "key": "orbit_key",
      "value": "orbit-local-key"
    },
    {
      "key": "external_id",
      "value": ""
    },
    {
      "key": "created_order_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.expect([200]).to.include(pm.response.code); });",
              "pm.test(\"Request ID returned\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok; });"
            ]
          }
        }
      ]
    },
    {
      "name": "Database readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.expect([200]).to.include(pm.response.code); });",
              "pm.test(\"Request ID returned\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok; });"
            ]
          }
        }
      ]
    },
    {
      "name": "Orders without credentials",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/v1/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.expect([401]).to.include(pm.response.code); });",
              "pm.test(\"Request ID returned\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok; });"
            ]
          }
        }
      ]
    },
    {
      "name": "Orders with incorrect credential",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer wrong-demo-key"
          }
        ],
        "url": "{{base_url}}/v1/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.expect([401]).to.include(pm.response.code); });",
              "pm.test(\"Request ID returned\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok; });"
            ]
          }
        }
      ]
    },
    {
      "name": "List Acme orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{acme_key}}"
          }
        ],
        "url": "{{base_url}}/v1/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.expect([200]).to.include(pm.response.code); });",
              "pm.test(\"Request ID returned\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok; });"
            ]
          }
        }
      ]
    },
    {
      "name": "List Orbit orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{orbit_key}}"
          }
        ],
        "url": "{{base_url}}/v1/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.expect([200]).to.include(pm.response.code); });",
              "pm.test(\"Request ID returned\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok; });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Acme order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{acme_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/v1/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"external_id\":\"{{external_id}}\"}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"external_id\", \"postman-\" + Date.now() + \"-\" + Math.random().toString(36).slice(2, 10));",
              "pm.collectionVariables.unset(\"created_order_id\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Request ID returned\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok; });",
              "pm.test(\"New order created\", function () { var data = pm.response.json(); pm.expect(data.created).to.eql(true); pm.expect(data.order.id).to.be.a(\"string\").and.not.empty; pm.expect(data.order.external_id).to.eql(pm.collectionVariables.get(\"external_id\")); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"created_order_id\", pm.response.json().order.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Replay the same Acme order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{acme_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/v1/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"external_id\":\"{{external_id}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Request ID returned\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok; });",
              "pm.test(\"Replay returns the original order\", function () { var data = pm.response.json(); pm.expect(data.created).to.eql(false); pm.expect(data.order.id).to.eql(pm.collectionVariables.get(\"created_order_id\")); pm.expect(data.order.external_id).to.eql(pm.collectionVariables.get(\"external_id\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify Acme can see its order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{acme_key}}"
          }
        ],
        "url": "{{base_url}}/v1/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Request ID returned\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok; });",
              "pm.test(\"Tenant visibility\", function () { var ids = pm.response.json().orders.map(function (order) { return order.id; }); pm.expect(ids).to.include(pm.collectionVariables.get(\"created_order_id\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify Orbit cannot see Acme order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{orbit_key}}"
          }
        ],
        "url": "{{base_url}}/v1/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Request ID returned\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok; });",
              "pm.test(\"Tenant visibility\", function () { var ids = pm.response.json().orders.map(function (order) { return order.id; }); pm.expect(ids).not.to.include(pm.collectionVariables.get(\"created_order_id\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid JSON",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/v1/orders",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{acme_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "not-json"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Request ID returned\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok; });",
              "pm.test(\"Invalid request response\", function () { pm.expect(pm.response.json().error).to.eql(\"invalid_request\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Inspect the first order page",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/v1/orders?limit=1",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{acme_key}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Request ID returned\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.ok; });",
              "pm.test(\"Page and continuation field returned\", function () { var data = pm.response.json(); pm.expect(data.orders).to.be.an(\"array\"); pm.expect(data.orders.length).to.be.at.most(1); pm.expect(data).to.have.property(\"next_cursor\"); });"
            ]
          }
        }
      ]
    }
  ]
}
